# Application
APP_NAME=AgeAyurveda Companion
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ageayurveda

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://ageayurveda.com,https://www.ageayurveda.com

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Rate Limiting
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_PRAKRITI=5/minute
RATE_LIMIT_READ=60/minute
