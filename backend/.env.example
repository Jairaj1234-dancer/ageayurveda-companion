APP_NAME=AgeAyurveda Companion
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

DATABASE_URL=sqlite+aiosqlite:///./ageayurveda.db

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Classical-text grounding (required for /api/v1/chat/grounded endpoints)
ANTHROPIC_API_KEY=
GROUNDED_MODEL=claude-opus-4-7
# Embedding model — bge-m3 is multilingual-strong (Sanskrit/IAST/English mix)
# with 8K context. ~2.5GB on first download, ~1024-dim vectors.
# Drop back to paraphrase-multilingual-MiniLM-L12-v2 (384-dim) for low-RAM dev.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RETRIEVAL_TOP_K=6
GROUNDED_MAX_TOKENS=2048

# Optional stage-2 cross-encoder reranker. When set, retrieval returns
# the top RETRIEVAL_TOP_K from a candidate pool of RETRIEVAL_RERANK_POOL.
# Recommended models (all free, local, no API cost):
#   BAAI/bge-reranker-v2-m3       — 568M, multilingual, best quality
#   BAAI/bge-reranker-base        — 110M, English-leaning, smaller
#   cross-encoder/ms-marco-MiniLM-L-6-v2  — 22M, English, very small
RETRIEVAL_RERANKER_MODEL=
RETRIEVAL_RERANK_POOL=30
